<?xml version="1.0" encoding="utf-8" ?>
<!-- sui:Class 填写对应 UIElementGroup 类名 -->
<Body xmlns:sui="https://github.com/487666123/SilkyUIFramework"
	  sui:Class="PointShop.UserInterfaces.DisplayUI.SUIDisplayItem"
	  CrossAlignment="Center" CrossContentAlignment="Center"
	  FitWidth="true" FitHeight="true"
	  Border="2" BorderRadius="4" Gap="2" OverflowHidden="true" FlexGrow="1">
	<Image sui:Name="Icon" FitWidth="false" FitHeight="false"
		   ImageScale="0.75" ImageAlign="0.5" Width="30px" Height="100%"/>
	<TextView sui:Name="PointsText" TextScale="0.75" TextAlign="0 0.5"
			  Height="100%" FlexGrow="1" FlexShrink="1" FitWidth="false"/>
</Body>
