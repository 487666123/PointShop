<?xml version="1.0" encoding="utf-8" ?>
<!-- sui:Class 填写对应 UIElementGroup 类名 -->
<Body xmlns:s="https://github.com/487666123/SilkyUIFramework"
	  xmlns:prop="https://github.com/487666123/SilkyUIFramework/Properties"
	  s:Class="PointShop.UserInterfaces.DisplayUI.PointsDisplayWidgetUI"
	  Enabled="true" Left="50#" Top="-20px -100% 100#"
	  CrossAlignment="Stretch" CrossContentAlignment="Stretch"
	  FitWidth="true" FitHeight="true"
	  EnableBlur ="true" Border="2" BorderRadius="8" Padding="0" Gap="0">

	<ElementGroup s:Name="Title" FitHeight="true" Padding="4" Width="100%"
				  BackgroundColor="rgba(0,0,0,0.25)" BorderRadius="2"
				  MainAlignment="Center" CrossAlignment="Center" CrossContentAlignment="Center">
		<TextView s:Name="TitleText" TextScale="0.75" TextAlign="0 0.5" />
	</ElementGroup>

	<HR BackgroundColor="rgba(0,0,0,0.75)"/>

	<ScrollView s:Name="ScrollView" Orientation="Vertical"
				Gap="4" Padding="4" Width="245px" Height="140px">
		<prop:Mask />
		<prop:Container LayoutType="Grid" Gap="4" GridDirection="Row"
					 GridItemsHorizontalAlignment="Stretch" GridVerticalAlignment="Stretch" />
	</ScrollView>

</Body>
