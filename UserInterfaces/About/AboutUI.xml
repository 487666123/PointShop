<?xml version="1.0" encoding="utf-8"?>
<Body Class="PointShop.UserInterfaces.About.AboutUI"
    FitWidth="false" FitHeight="true" Width="300px" Left="50#" Top="50#" Gap="0" Border="0" BackgroundColor="#00000000">
	<ElementGroup Name="MainPanel" FlexDirection="Column"
				  FitHeight="true" Width="100%" Gap="0" Border="2" BorderRadius="8">
		<CommonHeader Name="Header" />
		<HR/>
		<ElementGroup Width="100%" FitHeight="true" FlexDirection="Column" Padding="8" Gap="8">
			<ElementGroup Width="100%" Gap="8" Name="FankuiContainer" FitHeight="true" FlexDirection="Column">
				<TextView Padding="2" TextScale="0.8" Text="交流 &amp; 反馈" TextColor="#3399ff"/>
				<ElementGroup Width="100%" FitHeight="true" Gap="8">
					<DonateButton Name="QQFankui"/>
					<DonateButton Name="QQLianji"/>
				</ElementGroup>
			</ElementGroup>
			<TextView Name="Support" Padding="2" TextScale="0.8" Text="支持作者" TextColor="#3399ff"/>
			<ElementGroup Width="100%" FitHeight="true" Gap="8">
				<DonateButton Name="Kofi"/>
				<DonateButton Name="AFDian"/>
			</ElementGroup>
			<TextView Name="Acknowledgments" Padding="2" TextScale="0.8" Text="感谢所有游玩者的支持！" TextColor="#993333"/>
		</ElementGroup>
	</ElementGroup>
	<ElementGroup Name="RightPanel" Positioning="Absolute" Left="8px 100% 0#"
				  Width="80%" Height="100%" Gap="8" Padding="8" Border="2" BorderRadius="8" FlexDirection="Column">
		<!-- 捐赠标题 -->
		<TextView Name="DonorList" Padding="2" TextScale="0.8" Text="捐赠者" TextColor="#3399ff"/>
		<ScrollView Name="Donors" Width="100%" FitHeight="true" CrossAlignment="Stretch" Gap="4" FlexGrow="1">
			<M.Mask />
			<M.Container FlexDirection="Column" FitHeight="true" CrossAlignment="Stretch" Gap="4" />
		</ScrollView>
	</ElementGroup>
</Body>